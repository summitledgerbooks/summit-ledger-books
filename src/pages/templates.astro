---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { templateProducts } from "../data/templates";
import freeTemplatesImg from "../assets/templates/free-real-estate-templates.webp";

const siteOrigin = Astro.site?.origin ?? "https://summitledgerbooks.com";

const productImages = await Promise.all(
  templateProducts.map(async (product) => {
    if (!product.image) return undefined;
    const optimized = await getImage({ src: product.image, width: 1200, format: "webp" });
    const src = optimized.src;
    return src.startsWith("http://") || src.startsWith("https://")
      ? src
      : new URL(src, siteOrigin).href;
  }),
);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Real Estate and Bookkeeping Spreadsheet Templates",
  itemListElement: templateProducts.map((product, index) => {
    const image = productImages[index];
    return {
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: product.name,
        description: product.description ?? product.name,
        ...(image ? { image } : {}),
        url: product.url,
        brand: {
          "@type": "Brand",
          name: "Summit Ledger Books",
        },
        offers: {
          "@type": "Offer",
          price: product.price,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          url: product.url,
          seller: {
            "@type": "Organization",
            name: "Summit Ledger Books",
          },
        },
      },
    };
  }),
};
---

<Base
  seoTitle="Real Estate & Bookkeeping Spreadsheet Templates"
  description="Spreadsheets I built as a QuickBooks ProAdvisor and real estate investor. Landlord books, deal analysis, flips, and job costing, sold on Etsy."
>
  <div class="container">
    <h1 class="section-heading">Real Estate &amp; Bookkeeping Spreadsheet Templates</h1>
    <p style="color: var(--color-text-muted); max-width: 42rem; margin-bottom: var(--space-lg);">
      I built these spreadsheets as a QuickBooks ProAdvisor and a real estate investor. I sell them on Etsy.
    </p>
    <p class="template-coupon" style="max-width: 42rem; margin-bottom: var(--space-lg);">
      Use code <strong>SLB15</strong> for 15% off everything except the Starter Pack through January 1, 2027.
      <a href="https://summitledgershop.etsy.com?coupon=SLB15" target="_blank" rel="noopener noreferrer">Shop with the code on Etsy</a>
    </p>
    <div class="template-grid">
      <article class="card template-card template-card-free">
        <Image
          src={freeTemplatesImg}
          alt="Free real estate spreadsheet templates"
          width={400}
          height={225}
          densities={[1, 2]}
          class="template-card-img"
        />
        <div class="template-card-body">
          <h2>Free Real Estate Templates</h2>
          <p>Lite landlord, deal, flip, partner, and agent trackers.</p>
          <p class="template-price">Free</p>
          <a class="btn btn-primary" href="/free-templates/">Get the Free Templates</a>
        </div>
        <span class="template-ribbon">Free</span>
      </article>
      {templateProducts.map((product) => (
        <article class="card template-card">
          {product.image ? (
            <Image
              src={product.image}
              alt={product.imageAlt || product.name}
              width={400}
              height={225}
              densities={[1, 2]}
              class="template-card-img"
            />
          ) : (
            <div class="template-card-text" aria-hidden="true">
              <span>{product.name}</span>
            </div>
          )}
          <div class="template-card-body">
            {product.badge && <p class="popular-label">{product.badge}</p>}
            <h2>{product.name}</h2>
            {product.description && <p>{product.description}</p>}
            <p class="template-price">{product.priceLabel}</p>
            <a class="btn btn-primary" href={product.url} target="_blank" rel="noopener noreferrer">View on Etsy</a>
            {product.secondaryHref && product.secondaryLabel && (
              <p style="margin-top: var(--space-sm);"><a href={product.secondaryHref}>{product.secondaryLabel}</a></p>
            )}
          </div>
        </article>
      ))}
    </div>
    <p class="template-note">Prices shown on Etsy are current.</p>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</Base>
