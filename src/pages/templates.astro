---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import landlord from "../assets/templates/landlord-rental-bookkeeping.webp";
import brrrr from "../assets/templates/rental-brrrr-analyzer.webp";
import flip from "../assets/templates/house-flip-tracker.webp";
import partner from "../assets/templates/partner-profit-split.webp";
import contractor from "../assets/templates/contractor-job-costing.webp";

const shopUrl = "https://www.etsy.com/shop/SummitLedgerShop";

interface Product {
  name: string;
  price: string;
  priceLabel: string;
  description?: string;
  url: string;
  image?: ImageMetadata;
  imageAlt?: string;
  badge?: string;
}

const products: Product[] = [
  {
    name: "Investor Bundle",
    price: "49",
    priceLabel: "$49",
    description: "Landlord tracker, deal analyzer, flip tracker, and partner split tracker in one bundle, with quick-start guides.",
    url: "https://www.etsy.com/listing/4621188747",
    badge: "Best value",
  },
  {
    name: "Landlord Rental Bookkeeping Tracker",
    price: "24.99",
    priceLabel: "$24.99",
    description: "Rent, expenses, and Schedule E totals.",
    url: "https://www.etsy.com/listing/4621189882",
    image: landlord,
    imageAlt: "Landlord Rental Bookkeeping Tracker spreadsheet",
  },
  {
    name: "Rental & BRRRR Deal Analyzer",
    price: "19.99",
    priceLabel: "$19.99",
    description: "Cash flow, CoC return, and refi math.",
    url: "https://www.etsy.com/listing/4621191878",
    image: brrrr,
    imageAlt: "Rental and BRRRR deal analyzer spreadsheet",
  },
  {
    name: "House Flip Budget & Profit Tracker",
    price: "19.99",
    priceLabel: "$19.99",
    description: "Rehab budget to final profit.",
    url: "https://www.etsy.com/listing/4621192438",
    image: flip,
    imageAlt: "House flip budget and profit tracker spreadsheet",
  },
  {
    name: "Partner Profit Split Tracker",
    price: "14.99",
    priceLabel: "$14.99",
    description: "Fair, clear splits for every deal.",
    url: "https://www.etsy.com/listing/4621193018",
    image: partner,
    imageAlt: "Partner profit split tracker spreadsheet",
  },
  {
    name: "Agent Commission & Expense Tracker",
    price: "14.99",
    priceLabel: "$14.99",
    description: "Track commissions, business expenses, and quarterly tax set-asides in one simple spreadsheet.",
    url: "https://www.etsy.com/listing/4621193656",
  },
  {
    name: "Contractor Job Costing Workbook",
    price: "29",
    priceLabel: "$29",
    description: "Know your profit on every job.",
    url: "https://www.etsy.com/listing/4621180917",
    image: contractor,
    imageAlt: "Contractor job costing workbook spreadsheet",
  },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Real Estate and Bookkeeping Spreadsheet Templates",
  itemListElement: products.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Product",
      name: product.name,
      url: product.url,
      offers: {
        "@type": "Offer",
        price: product.price,
        priceCurrency: "USD",
      },
    },
  })),
};
---

<Base
  seoTitle="Real Estate & Bookkeeping Spreadsheet Templates"
  description="Spreadsheets I built as a QuickBooks ProAdvisor and real estate investor. Landlord books, deal analysis, flips, and job costing, sold on Etsy."
>
  <div class="container">
    <h1 class="section-heading">Real Estate &amp; Bookkeeping Spreadsheet Templates</h1>
    <p style="color: var(--color-text-muted); max-width: 42rem; margin-bottom: var(--space-lg);">
      I built these spreadsheets as a QuickBooks ProAdvisor and a real estate investor. I sell them on Etsy.
    </p>
    <p style="margin-bottom: var(--space-xl);">
      <a class="btn btn-primary" href={shopUrl} target="_blank" rel="noopener noreferrer">Visit the Etsy shop</a>
    </p>

    <div class="template-grid">
      {products.map((product) => (
        <article class="card template-card">
          {product.image ? (
            <Image
              src={product.image}
              alt={product.imageAlt || product.name}
              width={400}
              height={300}
              densities={[1, 2]}
              class="template-card-img"
            />
          ) : (
            <div class="template-card-text" aria-hidden="true">
              <span>{product.name}</span>
            </div>
          )}
          <div class="template-card-body">
            {product.badge && <p class="popular-label">{product.badge}</p>}
            <h2>{product.name}</h2>
            {product.description && <p>{product.description}</p>}
            <p class="template-price">{product.priceLabel}</p>
            <a class="btn btn-primary" href={product.url} target="_blank" rel="noopener noreferrer">View on Etsy</a>
          </div>
        </article>
      ))}
    </div>
    <p class="template-note">Prices shown on Etsy are current.</p>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</Base>
