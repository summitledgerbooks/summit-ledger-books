---
import Base from "../layouts/Base.astro";
import GoogleRating from "../components/GoogleRating.astro";
import { BOOKING_URL } from "../lib/site";
import pricingSchema from "../lib/schema/schema-pricing-offers.json";
---

<Base title="Pricing" description="Transparent real estate bookkeeping pricing. Monthly plans starting at $500/month. Catch-up bookkeeping quoted by scope. No hidden fees, no long-term contracts.">
  <div class="container">
    <h1 class="section-heading" style="text-align: center;">Simple, Transparent Pricing</h1>
    <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-xl); max-width: 36rem; margin-left: auto; margin-right: auto;">No hidden fees. No long-term contracts. Just reliable real estate bookkeeping at a fair price. Not sure what you need? <a href="/services/">See the full services breakdown.</a></p>

    <!-- Monthly Plans -->
    <h2 class="section-heading" style="text-align: center; font-size: 1.25rem; margin-bottom: var(--space-lg);">Monthly Bookkeeping</h2>
    <div class="card-grid">
      <div class="card pricing-card">
        <h3>Starter</h3>
        <p class="price-kicker">Starting at</p>
        <div class="price">$500<span style="font-size: 1rem; font-weight: 400; color: var(--color-text-muted);">/mo</span></div>
        <p style="font-size: 0.8125rem; font-weight: 600; color: var(--color-navy); margin-bottom: var(--space-md);">Best for 1&ndash;3 properties, single entity</p>
        <ul>
          <li>Monthly transaction categorization</li>
          <li>Bank &amp; credit card reconciliation</li>
          <li>Profit &amp; loss statement</li>
          <li>Balance sheet</li>
          <li>Email support</li>
        </ul>
        <a href={BOOKING_URL} class="btn btn-primary">Book a free call</a>
      </div>

      <div class="card pricing-card popular">
        <p class="popular-label">Most popular</p>
        <h3>Growth</h3>
        <p class="price-kicker">Starting at</p>
        <div class="price">$750<span style="font-size: 1rem; font-weight: 400; color: var(--color-text-muted);">/mo</span></div>
        <p style="font-size: 0.8125rem; font-weight: 600; color: var(--color-navy); margin-bottom: var(--space-md);">Best for 4&ndash;10 properties or multiple entities</p>
        <ul>
          <li>Everything in Starter</li>
          <li>Multi-property or multi-entity reporting</li>
          <li>Accounts payable &amp; receivable</li>
          <li><a href="/services/property-management-accounting/" style="color: inherit; text-decoration: underline; text-decoration-color: var(--color-border);">Rent roll reconciliation</a></li>
          <li><a href="/services/tax-prep-support/" style="color: inherit; text-decoration: underline; text-decoration-color: var(--color-border);">Tax prep support</a> (Schedule E ready)</li>
        </ul>
        <a href={BOOKING_URL} class="btn btn-primary">Book a free call</a>
      </div>

      <div class="card pricing-card">
        <h3>Premium</h3>
        <p class="price-kicker">Starting at</p>
        <div class="price">$1,200<span style="font-size: 1rem; font-weight: 400; color: var(--color-text-muted);">/mo</span></div>
        <p style="font-size: 0.8125rem; font-weight: 600; color: var(--color-navy); margin-bottom: var(--space-md);">Best for active portfolios, STR investors, and development projects</p>
        <ul>
          <li>Everything in Growth</li>
          <li>Property-level P&amp;L review with variance notes each month</li>
          <li>15-minute check-in call each month</li>
          <li>Priority support (same-day response)</li>
          <li>Depreciation schedule maintenance</li>
          <li><a href="/services/payroll-support/" style="color: inherit; text-decoration: underline; text-decoration-color: var(--color-border);">Payroll support</a></li>
        </ul>
        <a href={BOOKING_URL} class="btn btn-primary">Book a free call</a>
      </div>
    </div>

    <!-- Catch-Up Pricing -->
    <h2 class="section-heading" style="text-align: center; font-size: 1.25rem; margin-top: var(--space-xl); margin-bottom: var(--space-lg);">Catch-Up Bookkeeping</h2>
    <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-lg); max-width: 36rem; margin-left: auto; margin-right: auto;">Behind on your books? Pricing is based on how far back your records need to go and the volume of transactions involved.</p>

    <div class="card-grid" style="grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));">
      <div class="card pricing-card">
        <h3>1 to 2 Months</h3>
        <div class="price" style="font-size: 1.5rem;">$600 &ndash; $1,200</div>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin-top: var(--space-sm);">One-time project fee</p>
      </div>
      <div class="card pricing-card">
        <h3>3 to 6 Months</h3>
        <div class="price" style="font-size: 1.5rem;">$1,500 &ndash; $2,500</div>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin-top: var(--space-sm);">One-time project fee</p>
      </div>
      <div class="card pricing-card">
        <h3>6 to 12+ Months</h3>
        <div class="price" style="font-size: 1.5rem;">$3,000+</div>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin-top: var(--space-sm);">Custom quote after review</p>
      </div>
    </div>

    <!-- Catch-Up Payment Terms -->
    <div class="cpa-collab" style="margin-top: var(--space-lg); max-width: 100%;">
      <p style="font-weight: 600; color: var(--color-navy); margin-bottom: var(--space-sm);">Payment terms</p>
      <p style="color: var(--color-text-muted); font-size: 0.9375rem; line-height: 1.7;">Catch-up projects are billed as a flat fee. You can pay in full upfront, or split it: 50% at project start and 50% on completion.</p>
    </div>

    <!-- QuickBooks note -->
    <h2 class="section-heading" style="text-align: center; font-size: 1.25rem; margin-top: var(--space-xl); margin-bottom: var(--space-lg);">Construction &amp; Contractor Bookkeeping</h2>
    <p style="text-align: center; color: var(--color-text-muted); margin-bottom: var(--space-lg); max-width: 36rem; margin-left: auto; margin-right: auto;">Monthly bookkeeping for builders, remodelers, and trade contractors, with job costing, WIP schedules, progress billing, retainage, and subcontractor 1099s. Pricing depends on your active jobs and volume, so I quote it after a free call.</p>
    <p style="text-align: center; margin-bottom: var(--space-lg);"><a href={BOOKING_URL} class="btn btn-primary">Book a free call</a></p>

    <div class="cpa-collab" style="margin-top: var(--space-md); max-width: 100%;">
      <p style="font-weight: 600; color: var(--color-navy); margin-bottom: var(--space-sm);">A note on QuickBooks</p>
      <p style="color: var(--color-text-muted); font-size: 0.9375rem; line-height: 1.7;">QuickBooks subscription fees are billed separately and not included in the pricing above. If you need a QuickBooks subscription, I can help you enroll through my ProAdvisor access, which may qualify you for preferred pricing options.</p>
    </div>

    <div style="text-align: center; margin-top: var(--space-xl);">
      <p style="color: var(--color-text-muted); margin-bottom: var(--space-md);">Not sure which plan fits your portfolio? Let's talk through it.</p>
      <GoogleRating />
      <a href={BOOKING_URL} class="btn btn-primary" style="margin-top: var(--space-md);">Book a free call</a>
      <p style="margin-top: var(--space-lg); font-size: 0.875rem; color: var(--color-text-muted);">Machine-readable pricing: <a href="/pricing.md">/pricing.md</a></p>
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
</Base>
