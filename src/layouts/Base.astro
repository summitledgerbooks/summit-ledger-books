---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import SEO from "../components/SEO.astro";
import "../styles/global.css";
import mtnLogo from "../assets/images/mtn-logo.png";
import footerLogo from "../assets/images/logo.png";
import badgeQboLevel2 from "../assets/images/badge-qbo-level-2.png";
import badgeQboPayroll from "../assets/images/badge-qbo-payroll.png";
import heroBanner from "../assets/images/background-banner.jpg";
import { BOOKING_URL, GOOGLE_PROFILE_URL, PROADVISOR_URL } from "../lib/site";
import { businessSchema } from "../lib/business";

interface Props {
  title?: string;
  seoTitle?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  bookingBar?: boolean;
  noindex?: boolean;
  noCanonical?: boolean;
}

const { title, seoTitle, description, ogType, ogImage, bookingBar = false, noindex = false, noCanonical = false } = Astro.props;
const pathname = Astro.url.pathname;
const path = pathname === "/" ? "/" : pathname.replace(/\/$/, "");
const heroImage = await getImage({
  src: heroBanner,
  format: "webp",
  width: 1536,
  quality: 68,
});

const allServices = await getCollection("services");
const sortedServices = allServices.sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
  <head>
    <SEO title={title} seoTitle={seoTitle} description={description} ogType={ogType} ogImage={ogImage} noindex={noindex} noCanonical={noCanonical} />
    {pathname === "/" && <link rel="preload" as="image" href={heroImage.src} fetchpriority="high" />}
    <script is:inline>
      window.addEventListener("load", function () {
        var ga = document.createElement("script");
        ga.src = "https://www.googletagmanager.com/gtag/js?id=G-ERKMFNNSXR";
        ga.async = true;
        document.head.appendChild(ga);
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", "G-ERKMFNNSXR");

        function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}
        loadScript(function(){beTracker.t({hash:"2a4c402b57cbd4be98358aacd61e78b2"})});
      });
    </script>
  </head>
  <body class={bookingBar ? "has-booking-bar" : undefined} style={`--hero-image: url('${heroImage.src}')`}>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <Image src={mtnLogo} style="width: 50px; height: 50px;" alt="Summit Ledger Books" />
          <span class="logo-text" aria-hidden="true">Summit Ledger <span class="logo-text-sub">Books</span></span>
        </a>
        <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
        <ul class="site-nav">
          <li><a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a></li>
          <li><a href="/about/" aria-current={path === "/about" ? "page" : undefined}>About</a></li>
          <li class="nav-dropdown">
            <a href="/services/" aria-current={path.startsWith("/services") ? "page" : undefined}>Services <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></a>
            <ul class="dropdown-menu">
              {sortedServices.map((s) => (
                <li><a href={`/services/${s.id}/`} aria-current={path === `/services/${s.id}` ? "page" : undefined}>{s.data.title}</a></li>
              ))}
              <li class="nav-templates-desktop"><a href="/templates/" aria-current={path === "/templates" ? "page" : undefined}>Templates</a></li>
              <li class="dropdown-divider"><a href="/services/">View all services &rarr;</a></li>
            </ul>
          </li>
          <li><a href="/pricing/" aria-current={path === "/pricing" ? "page" : undefined}>Pricing</a></li>
          <li><a href="/faq/" aria-current={path === "/faq" ? "page" : undefined}>FAQ</a></li>
          <li><a href="/blog/" aria-current={path.startsWith("/blog") ? "page" : undefined}>Blog</a></li>
          <li><a href="/contact/" aria-current={path === "/contact" ? "page" : undefined}>Contact</a></li>
          <li class="nav-templates-mobile"><a href="/templates/" aria-current={path === "/templates" ? "page" : undefined}>Templates</a></li>
          <li><a class="btn btn-primary nav-book" href={BOOKING_URL}>Book a Free Call</a></li>
        </ul>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="logo" aria-label="Summit Ledger Books">
              <Image src={footerLogo} alt="Summit Ledger Books" height={64} densities={[1, 2]} />
            </a>
            <p class="footer-tagline">Let me focus on the books. You focus on the summit.</p>
            <div class="badge-row badge-row--footer">
              <a href={PROADVISOR_URL} rel="noopener">
                <Image src={badgeQboLevel2} alt="Certified QuickBooks Online ProAdvisor, Level 2" class="badge-img" width={80} height={80} densities={[1, 2]} />
              </a>
              <Image src={badgeQboPayroll} alt="QuickBooks Payroll certification" class="badge-img" width={80} height={80} densities={[1, 2]} />
            </div>
          </div>

          <div class="footer-links">
            <p class="footer-heading">Navigation</p>
            <ul class="footer-nav">
              <li><a href="/about/">About</a></li>
              <li><a href="/services/">Services</a></li>
              <li><a href="/templates/">Templates</a></li>
              <li><a href="/free-templates/">Free Templates</a></li>
              <li><a href="/pricing/">Pricing</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
            <p class="footer-heading" style="margin-top: var(--space-md);">Service Areas</p>
            <ul class="footer-nav">
              <li><a href="/bookkeeping-davis-county/">Davis County, UT</a></li>
              <li><a href="/bookkeeping-salt-lake-county/">Salt Lake County, UT</a></li>
            </ul>
          </div>

          <div class="footer-contact">
            <p class="footer-heading">Get in touch</p>
            <p class="footer-contact-item">Kaysville, Utah</p>
            <p class="footer-contact-item"><a href="mailto:austin@summitledgerbooks.com">austin@summitledgerbooks.com</a></p>
            <p class="footer-contact-item"><a href="tel:+13854502276">385-450-2276</a></p>
            <p class="footer-contact-item">
              <a href="https://www.linkedin.com/company/summit-ledger-books/" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.4rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                Connect on LinkedIn
              </a>
            </p>
            <p class="footer-contact-item">
              <a href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.4rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                </svg>
                Find us on Google
              </a>
            </p>
            <div class="footer-cta">
              <p style="font-size: 0.875rem; margin-bottom: var(--space-sm);">Ready to get organized?</p>
              <a href={BOOKING_URL} class="btn btn-primary">Book a Free Call</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Summit Ledger Books. All rights reserved. &nbsp;·&nbsp; <a href="/privacy/">Privacy Policy</a></p>
        </div>
      </div>
    </footer>

    {bookingBar && (
      <div class="booking-bar" id="booking-bar">
        <a class="btn btn-primary" href={BOOKING_URL}>Book a Free Call</a>
      </div>
    )}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <script>
      const toggle = document.querySelector(".nav-toggle");
      const nav = document.querySelector(".site-nav");
      if (toggle && nav) {
        toggle.addEventListener("click", () => {
          const expanded = nav.classList.toggle("open");
          toggle.setAttribute("aria-expanded", String(expanded));
        });
      }
      // Mobile dropdown toggle
      const dropdown = document.querySelector(".nav-dropdown > a");
      if (dropdown && window.innerWidth <= 768) {
        dropdown.addEventListener("click", (e) => {
          if (window.innerWidth <= 768) {
            e.preventDefault();
            dropdown.parentElement?.classList.toggle("open");
          }
        });
      }
      const bookingBarEl = document.getElementById("booking-bar");
      const footerEl = document.querySelector(".site-footer");
      if (bookingBarEl && footerEl && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          bookingBarEl.classList.toggle("is-hidden", entries[0]?.isIntersecting === true);
        });
        observer.observe(footerEl);
      }
    </script>
  </body>
</html>
